<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wg_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wg_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wg_today"
            android:textColor="@color/wg_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wg_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wg_label2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wg_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- 4 个固定行槽位：RemoteViews 不能动态 addView，用显隐控制 -->
        <LinearLayout
            android:id="@+id/wg_row1"
            style="@style/WgRow">

            <TextView
                android:id="@+id/wg_time1"
                style="@style/WgTime" />

            <View
                android:id="@+id/wg_bar1"
                style="@style/WgBar" />

            <LinearLayout style="@style/WgTexts">
                <TextView
                    android:id="@+id/wg_name1"
                    style="@style/WgName" />

                <TextView
                    android:id="@+id/wg_room1"
                    style="@style/WgRoom" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_row2"
            style="@style/WgRow">

            <TextView
                android:id="@+id/wg_time2"
                style="@style/WgTime" />

            <View
                android:id="@+id/wg_bar2"
                style="@style/WgBar" />

            <LinearLayout style="@style/WgTexts">
                <TextView
                    android:id="@+id/wg_name2"
                    style="@style/WgName" />

                <TextView
                    android:id="@+id/wg_room2"
                    style="@style/WgRoom" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_row3"
            style="@style/WgRow">

            <TextView
                android:id="@+id/wg_time3"
                style="@style/WgTime" />

            <View
                android:id="@+id/wg_bar3"
                style="@style/WgBar" />

            <LinearLayout style="@style/WgTexts">
                <TextView
                    android:id="@+id/wg_name3"
                    style="@style/WgName" />

                <TextView
                    android:id="@+id/wg_room3"
                    style="@style/WgRoom" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_row4"
            style="@style/WgRow">

            <TextView
                android:id="@+id/wg_time4"
                style="@style/WgTime" />

            <View
                android:id="@+id/wg_bar4"
                style="@style/WgBar" />

            <LinearLayout style="@style/WgTexts">
                <TextView
                    android:id="@+id/wg_name4"
                    style="@style/WgName" />

                <TextView
                    android:id="@+id/wg_room4"
                    style="@style/WgRoom" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wg_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/wg_today_empty"
        android:textColor="@color/wg_label2"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wg_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/wg_label2"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
